# ── Secrets / environment ─────────────────────────────────────────────────────
# Ignore every env file (.env, .env.local, .env.production, …) but keep the
# templates. Templates must only ever contain placeholder values.
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Local databases ───────────────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Service runtime data (agent settings, sessions, briefs, cloned repos) ─────
services/dev-agent-service/data/

# ── Logs & runtime files (run-local.sh writes to logs/) ───────────────────────
logs/
*.log
*.pid

# ── Editors / tooling ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.claude/settings.local.json

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
