PORT=3007
TICKET_SERVICE_URL=http://ticket-service:3001
# URL the coding agent's MCP server (running on the developer's machine) uses
TICKET_SERVICE_PUBLIC_URL=http://localhost:3001

# Where settings, sessions and briefs are stored
DEV_AGENT_DATA_DIR=./data

# Initial settings (editable later from the dashboard → Agent settings)
AGENT_REPO_PATH=
AGENT_REPO_URL=
AGENT_DEFAULT=claude-code
AGENT_AUTO_PREPARE=false

# Python used to launch the MCP server for coding agents (stdlib only)
MCP_PYTHON=python

# LLM (for breakdown and the brief's AI plan) – pick one: gemini | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
